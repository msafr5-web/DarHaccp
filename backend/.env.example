NODE_ENV=development
PORT=4000
APP_TIMEZONE=Asia/Riyadh

# PostgreSQL
DATABASE_URL=postgres://dar:dar_password@localhost:5432/dar_haccp
DB_POOL_MAX=20
DB_SSL=false

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=10h
JWT_ISSUER=dar-al-dhiafa-ims

# Field-level AES-256-GCM key for national ID / iqama numbers — 64 hex chars. KEEP IT SAFE: losing it makes those fields unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10

# QR codes — the payload printed on each label (mobile app extracts the token)
QR_BASE_URL=https://haccp.daraldhiafa.sa/q

# Alerts
HEALTH_CERT_WARNING_DAYS=30
SCHEDULER_INTERVAL_MINUTES=60
EXPO_PUSH_ENABLED=false

# Seed (first admin account)
SEED_ADMIN_EMAIL=admin@daraldhiafa.sa
SEED_ADMIN_PASSWORD=ChangeMe!2026
