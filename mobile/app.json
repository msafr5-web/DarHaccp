{
  "expo": {
    "name": "دار الضيافة HACCP",
    "slug": "dar-al-dhiafa-haccp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.daraldhiafa.haccp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5D3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sa.daraldhiafa.haccp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "دار الضيافة HACCP",
      "themeColor": "#0B5D3B",
      "lang": "ar"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج التطبيق إلى الكاميرا لمسح رموز QR الخاصة بنماذج سلامة الغذاء",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B5D3B"
        }
      ]
    ],
    "scheme": "darhaccp",
    "extra": {
      "apiUrl": "https://dar-haccp-api.vercel.app/api/v1"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
